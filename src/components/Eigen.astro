---
// Hero figure: eigenvalues of a random 500-species community matrix.
// Independent interactions fill a disk (circular law); correlated interactions
// (corr(A_ij, A_ji) = 0.5) stretch it into an ellipse (elliptic law).
// Data computed with numpy, see src/data/eigenvalues.json.
import data from '../data/eigenvalues.json';

const S = 100; // scale: 1 unit = 100 SVG units
const byReal = (a: number[][]) => [...a].sort((p, q) => p[0] - q[0] || p[1] - q[1]);
const circ = byReal(data.circular);
const ell = byReal(data.elliptic);
const pts = circ.map((c, i) => {
  const e = ell[i];
  const r = Math.hypot(c[0], c[1]);
  return {
    cx: +(c[0] * S).toFixed(1),
    cy: +(-c[1] * S).toFixed(1),
    ex: +(e[0] * S).toFixed(1),
    ey: +(-e[1] * S).toFixed(1),
    delay: Math.round(r * 900 + (i % 7) * 18),
  };
});
---

<figure class="eigen">
  <svg viewBox="-170 -128 340 256" role="img" aria-labelledby="eig-title eig-desc">
    <title id="eig-title">Eigenvalues of a random community matrix</title>
    <desc id="eig-desc">
      Five hundred eigenvalues of a random interaction matrix, plotted in the complex plane. They fill a disk when
      interactions are independent, and an ellipse when interactions between pairs of species are correlated.
    </desc>
    <line class="axis" x1="-165" y1="0" x2="165" y2="0"></line>
    <line class="axis" x1="0" y1="-124" x2="0" y2="124"></line>
    <ellipse class="bound circ-bound" cx="0" cy="0" rx="100" ry="100"></ellipse>
    <ellipse class="bound ell-bound" cx="0" cy="0" rx="150" ry="50"></ellipse>
    <g class="dots">
      {
        pts.map((p) => (
          <circle
            r="1.45"
            style={`--cx:${p.cx}px;--cy:${p.cy}px;--ex:${p.ex}px;--ey:${p.ey}px;--d:${p.delay}ms`}
          />
        ))
      }
    </g>
    <text class="lbl" x="160" y="-6" text-anchor="end">Re</text>
    <text class="lbl" x="6" y="-114">Im</text>
  </svg>
  <figcaption>
    <div class="toggle" role="group" aria-label="Interaction structure">
      <button type="button" data-mode="circ" aria-pressed="true">Independent</button>
      <button type="button" data-mode="ell" aria-pressed="false">Correlated, ρ = 0.5</button>
    </div>
    <p>
      <span class="eyebrow">Fig. 1</span> Eigenvalues of a random community matrix with 500 species. Independent
      interactions fill a disk (the circular law); correlated pairs of interactions stretch it into an ellipse.
    </p>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('figure.eigen').forEach((fig) => {
    const buttons = fig.querySelectorAll<HTMLButtonElement>('button[data-mode]');
    const select = (b: HTMLButtonElement) => {
      fig.dataset.mode = b.dataset.mode;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    };
    buttons.forEach((b) => b.addEventListener('click', () => select(b)));
    // A link to /#correlated opens the figure in the correlated (elliptic) state.
    if (location.hash === '#correlated') select(buttons[1]);
  });
</script>

<style>
  .eigen {
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .axis {
    stroke: var(--rule-strong);
    stroke-width: 0.6;
  }

  .bound {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.6;
    stroke-dasharray: 2 3;
    opacity: 0.55;
    transition: opacity 0.6s ease;
  }

  .ell-bound {
    opacity: 0;
  }

  .eigen[data-mode='ell'] .circ-bound {
    opacity: 0;
  }

  .eigen[data-mode='ell'] .ell-bound {
    opacity: 0.55;
  }

  .dots circle {
    fill: var(--accent);
    opacity: 0.82;
    transform: translate(var(--cx), var(--cy));
    transition: transform 1.1s cubic-bezier(0.65, 0, 0.35, 1);
    transition-delay: calc(var(--d) * 0.25);
  }

  .eigen[data-mode='ell'] .dots circle {
    transform: translate(var(--ex), var(--ey));
  }

  @media (prefers-reduced-motion: no-preference) {
    .dots circle {
      /* "backwards" (not "both") so the toggle transition can take over after the intro */
      animation: bloom 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
      animation-delay: var(--d);
    }
  }

  @keyframes bloom {
    from {
      opacity: 0;
      transform: translate(0, 0);
    }
    to {
      opacity: 0.82;
      transform: translate(var(--cx), var(--cy));
    }
  }

  .lbl {
    font-family: var(--mono);
    font-size: 7px;
    fill: var(--muted);
  }

  figcaption {
    margin-top: 1rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted);
  }

  figcaption p {
    margin: 0.9rem 0 0;
    max-width: 30rem;
  }

  figcaption .eyebrow {
    color: var(--accent);
    margin-right: 0.4rem;
  }

  .toggle {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    gap: 2px;
  }

  .toggle button {
    font: inherit;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    background: transparent;
    border: 0;
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .toggle button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
</style>

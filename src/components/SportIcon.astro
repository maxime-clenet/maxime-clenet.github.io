---
// Small line pictogram for an endurance effort: a runner or a bicycle.
interface Props {
  sport: 'run' | 'bike';
}
const { sport } = Astro.props;
const label = sport === 'run' ? 'Running' : 'Cycling';
---

<svg class="sport" viewBox="0 0 24 24" role="img" aria-label={label}>
  <title>{label}</title>
  {
    sport === 'run' ? (
      <g>
        <circle cx="15" cy="4.2" r="1.9" class="fill" />
        <path d="M13.4 7.6 10.6 13.2" />
        <path d="M7.4 9.6 10.4 7.6 13.4 7.6 15.6 10.6 18.2 11.2" />
        <path d="M10.6 13.2 14 16 12.8 20.6" />
        <path d="M10.6 13.2 8.6 16.8 4.8 17.4" />
      </g>
    ) : (
      <g>
        <circle cx="5.6" cy="16.4" r="3.6" />
        <circle cx="18.4" cy="16.4" r="3.6" />
        <path d="M5.6 16.4 9.4 9.4 15.6 9.4 18.4 16.4" />
        <path d="M5.6 16.4 11.6 16.4 15.6 9.4" />
        <path d="M9.4 9.4 8.6 7.4 M7.2 7.4 10.2 7.4" />
        <path d="M15.6 9.4 14.8 6.6 17 6.2" />
      </g>
    )
  }
</svg>

<style>
  .sport {
    width: 1.15em;
    height: 1.15em;
    flex: none;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sport .fill {
    fill: var(--accent);
    stroke: none;
  }
</style>

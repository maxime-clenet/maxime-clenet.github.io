---
// Small line illustrations for each research theme (decorative).
import data from '../data/eigenvalues.json';

interface Props {
  kind: 'contribution' | 'disk' | 'patches' | 'temporal' | 'qubits';
}
const { kind } = Astro.props;

// contribution: a few species carry most of the function (geometric decay)
const bars = Array.from({ length: 14 }, (_, i) => 62 * Math.pow(0.72, i) + 3);

// disk: a sample of the elliptic-law eigenvalues
const sample = data.elliptic.filter((_, i) => i % 3 === 0).map(([x, y]) => [80 + x * 40, 45 - y * 40]);

// patches: habitat patches connected by dispersal
const patches = [
  [28, 30, 9], [62, 18, 6], [96, 34, 11], [46, 62, 7], [84, 66, 5], [128, 56, 8], [138, 22, 5],
];
const links = [[0, 1], [1, 2], [0, 3], [3, 4], [2, 4], [2, 5], [5, 6], [2, 6]];

// temporal: the same nodes, different interactions at three times
const tn = [[10, 14], [30, 8], [26, 30], [8, 34]];
const te = [
  [[0, 1], [1, 2], [2, 3]],
  [[0, 2], [1, 3], [0, 1]],
  [[2, 3], [0, 3], [1, 2], [0, 2]],
];

// qubits: a superconducting quantum computer, the "chandelier" of a dilution refrigerator:
// stacked plates that narrow downwards, joined by rods and coiled coaxial cables, with the chip at the bottom.
const QX = 80;
const plates = [
  [8, 66],
  [26, 54],
  [42, 44],
  [56, 34],
  [67, 24],
];
const rods = plates.slice(0, -1).flatMap(([y, w], i) => {
  const [y2, w2] = plates[i + 1];
  return [-1, 1].map((s) => [QX + s * (w / 2 - 4), y + 1.5, QX + s * (w2 / 2 - 4), y2 - 1.5]);
});
const cables = [-0.5, -0.17, 0.17, 0.5].map((f) =>
  plates
    .slice(0, -1)
    .map(([y, w], i) => {
      const [y2, w2] = plates[i + 1];
      const x1 = QX + f * (w - 22);
      const x2 = QX + f * (w2 - 22);
      const m = (y + y2) / 2;
      const b = (i % 2 ? -1 : 1) * 3.5;
      return `M${x1} ${y + 1.5} C${x1 + b} ${m - 2} ${x2 - b} ${m + 2} ${x2} ${y2 - 1.5}`;
    })
    .join(' '),
);
---

<svg class="glyph" viewBox="0 0 160 90" aria-hidden="true" focusable="false">
  {
    kind === 'contribution' && (
      <g>
        <line class="base" x1="6" y1="80" x2="154" y2="80" />
        {bars.map((h, i) => (
          <rect class={i < 3 ? 'fill' : 'soft'} x={10 + i * 10.4} y={80 - h} width="6.5" height={h} rx="1.5" />
        ))}
      </g>
    )
  }
  {
    kind === 'disk' && (
      <g>
        <line class="base" x1="10" y1="45" x2="150" y2="45" />
        <line class="base" x1="80" y1="8" x2="80" y2="82" />
        <ellipse class="ring" cx="80" cy="45" rx="60" ry="20" />
        {sample.map(([x, y]) => (
          <circle class="dot" cx={x.toFixed(1)} cy={y.toFixed(1)} r="1.1" />
        ))}
      </g>
    )
  }
  {
    kind === 'patches' && (
      <g>
        {links.map(([a, b]) => (
          <line class="edge" x1={patches[a][0]} y1={patches[a][1]} x2={patches[b][0]} y2={patches[b][1]} />
        ))}
        {patches.map(([x, y, r], i) => (
          <circle class={i % 3 === 1 ? 'hollow' : 'node'} cx={x} cy={y} r={r} />
        ))}
      </g>
    )
  }
  {
    kind === 'temporal' && (
      <g>
        {te.map((edges, k) => (
          <g transform={`translate(${12 + k * 50} 18)`}>
            <rect class="frame" x="-4" y="-6" width="46" height="50" rx="6" />
            {edges.map(([a, b]) => (
              <line class="edge strong" x1={tn[a][0]} y1={tn[a][1]} x2={tn[b][0]} y2={tn[b][1]} />
            ))}
            {tn.map(([x, y]) => (
              <circle class="node" cx={x} cy={y} r="3.2" />
            ))}
          </g>
        ))}
        <line class="base" x1="12" y1="82" x2="150" y2="82" />
        <path class="base" d="M146 79 L150 82 L146 85" fill="none" />
      </g>
    )
  }
  {
    kind === 'qubits' && (
      <g>
        <line class="base" x1={QX - 24} y1="2" x2={QX - 24} y2="8" />
        <line class="base" x1={QX + 24} y1="2" x2={QX + 24} y2="8" />
        {rods.map(([x1, y1, x2, y2]) => (
          <line class="rod" x1={x1} y1={y1} x2={x2} y2={y2} />
        ))}
        {cables.map((d) => (
          <path class="cable" d={d} />
        ))}
        {plates.map(([y, w], i) => (
          <rect class={i === 0 ? 'fill' : 'plate'} x={QX - w / 2} y={y - 1.6} width={w} height="3.2" rx="1.2" />
        ))}
        <line class="rod" x1={QX} y1="68.6" x2={QX} y2="74" />
        <rect class="chip" x={QX - 6} y="74" width="12" height="9" rx="1.5" />
        <circle class="fill" cx={QX} cy="78.5" r="1.8" />
      </g>
    )
  }
</svg>

<style>
  .glyph {
    display: block;
    width: 100%;
    height: auto;
  }
  .base {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .fill {
    fill: var(--accent);
  }
  .soft {
    fill: var(--accent);
    opacity: 0.28;
  }
  .ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.8;
    stroke-dasharray: 2 2.5;
    opacity: 0.6;
  }
  .dot {
    fill: var(--accent);
    opacity: 0.85;
  }
  .edge {
    stroke: var(--rule-strong);
    stroke-width: 1.1;
  }
  .edge.strong {
    stroke: var(--accent);
    opacity: 0.7;
  }
  .edge.dashed {
    stroke-dasharray: 3 3;
  }
  .node {
    fill: var(--accent);
  }
  .hollow {
    fill: var(--paper);
    stroke: var(--accent);
    stroke-width: 1.3;
  }
  .frame {
    fill: none;
    stroke: var(--rule);
  }
  .plate {
    fill: var(--accent);
    opacity: 0.75;
  }
  .rod {
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.55;
  }
  .cable {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.9;
    opacity: 0.8;
  }
  .chip {
    fill: var(--paper);
    stroke: var(--accent);
    stroke-width: 1.3;
  }
</style>

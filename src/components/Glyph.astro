---
// Small line illustrations for each research theme (decorative).
import data from '../data/eigenvalues.json';

interface Props {
  kind: 'contribution' | 'disk' | 'patches' | 'temporal' | 'qubits';
}
const { kind } = Astro.props;

// contribution: a few species carry most of the function (geometric decay)
const bars = Array.from({ length: 14 }, (_, i) => 62 * Math.pow(0.72, i) + 3);

// disk: a sample of the elliptic-law eigenvalues
const sample = data.elliptic.filter((_, i) => i % 3 === 0).map(([x, y]) => [80 + x * 40, 45 - y * 40]);

// patches: habitat patches connected by dispersal
const patches = [
  [28, 30, 9], [62, 18, 6], [96, 34, 11], [46, 62, 7], [84, 66, 5], [128, 56, 8], [138, 22, 5],
];
const links = [[0, 1], [1, 2], [0, 3], [3, 4], [2, 4], [2, 5], [5, 6], [2, 6]];

// temporal: the same nodes, different interactions at three times
const tn = [[10, 14], [30, 8], [26, 30], [8, 34]];
const te = [
  [[0, 1], [1, 2], [2, 3]],
  [[0, 2], [1, 3], [0, 1]],
  [[2, 3], [0, 3], [1, 2], [0, 2]],
];

// qubits: a quantum chip — a processor with pins, an atom at its core, and circuit traces
// ending in terminals.
const QX = 80;
const QY = 45;
const pinOffs = [-12, -4, 4, 12];
const pins = pinOffs.flatMap((o) => [
  [QX + o, QY - 18, QX + o, QY - 24],
  [QX + o, QY + 18, QX + o, QY + 24],
  [QX - 18, QY + o, QX - 24, QY + o],
  [QX + 18, QY + o, QX + 24, QY + o],
]);
const half = [
  [[56, 33], [50, 33], [40, 23]],
  [[56, 41], [30, 41]],
  [[56, 57], [50, 57], [40, 67]],
  [[68, 21], [68, 14], [60, 6]],
  [[68, 69], [68, 76], [60, 84]],
];
const traces = [...half, ...half.map((t) => t.map(([x, y]) => [160 - x, y]))];
---

<svg class="glyph" viewBox="0 0 160 90" aria-hidden="true" focusable="false">
  {
    kind === 'contribution' && (
      <g>
        <line class="base" x1="6" y1="80" x2="154" y2="80" />
        {bars.map((h, i) => (
          <rect class={i < 3 ? 'fill' : 'soft'} x={10 + i * 10.4} y={80 - h} width="6.5" height={h} rx="1.5" />
        ))}
      </g>
    )
  }
  {
    kind === 'disk' && (
      <g>
        <line class="base" x1="10" y1="45" x2="150" y2="45" />
        <line class="base" x1="80" y1="8" x2="80" y2="82" />
        <ellipse class="ring" cx="80" cy="45" rx="60" ry="20" />
        {sample.map(([x, y]) => (
          <circle class="dot" cx={x.toFixed(1)} cy={y.toFixed(1)} r="1.1" />
        ))}
      </g>
    )
  }
  {
    kind === 'patches' && (
      <g>
        {links.map(([a, b]) => (
          <line class="edge" x1={patches[a][0]} y1={patches[a][1]} x2={patches[b][0]} y2={patches[b][1]} />
        ))}
        {patches.map(([x, y, r], i) => (
          <circle class={i % 3 === 1 ? 'hollow' : 'node'} cx={x} cy={y} r={r} />
        ))}
      </g>
    )
  }
  {
    kind === 'temporal' && (
      <g>
        {te.map((edges, k) => (
          <g transform={`translate(${12 + k * 50} 18)`}>
            <rect class="frame" x="-4" y="-6" width="46" height="50" rx="6" />
            {edges.map(([a, b]) => (
              <line class="edge strong" x1={tn[a][0]} y1={tn[a][1]} x2={tn[b][0]} y2={tn[b][1]} />
            ))}
            {tn.map(([x, y]) => (
              <circle class="node" cx={x} cy={y} r="3.2" />
            ))}
          </g>
        ))}
        <line class="base" x1="12" y1="82" x2="150" y2="82" />
        <path class="base" d="M146 79 L150 82 L146 85" fill="none" />
      </g>
    )
  }
  {
    kind === 'qubits' && (
      <g>
        {traces.map((t) => (
          <polyline class="trace" points={t.map((p) => p.join(',')).join(' ')} />
        ))}
        {pins.map(([x1, y1, x2, y2]) => (
          <line class="pin" x1={x1} y1={y1} x2={x2} y2={y2} />
        ))}
        {traces.map((t) => (
          <circle class="hollow" cx={t[t.length - 1][0]} cy={t[t.length - 1][1]} r="3.2" />
        ))}
        <rect class="chip" x={QX - 18} y={QY - 18} width="36" height="36" rx="4" />
        <rect class="core" x={QX - 12} y={QY - 12} width="24" height="24" rx="2.5" />
        {[0, 60, 120].map((a) => (
          <ellipse class="orbit" cx={QX} cy={QY} rx="9.5" ry="3.6" transform={`rotate(${a} ${QX} ${QY})`} />
        ))}
        <circle class="fill" cx={QX} cy={QY} r="1.8" />
      </g>
    )
  }
</svg>

<style>
  .glyph {
    display: block;
    width: 100%;
    height: auto;
  }
  .base {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .fill {
    fill: var(--accent);
  }
  .soft {
    fill: var(--accent);
    opacity: 0.28;
  }
  .ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.8;
    stroke-dasharray: 2 2.5;
    opacity: 0.6;
  }
  .dot {
    fill: var(--accent);
    opacity: 0.85;
  }
  .edge {
    stroke: var(--rule-strong);
    stroke-width: 1.1;
  }
  .edge.strong {
    stroke: var(--accent);
    opacity: 0.7;
  }
  .edge.dashed {
    stroke-dasharray: 3 3;
  }
  .node {
    fill: var(--accent);
  }
  .hollow {
    fill: var(--paper);
    stroke: var(--accent);
    stroke-width: 1.3;
  }
  .frame {
    fill: none;
    stroke: var(--rule);
  }
  .trace {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.1;
    stroke-linejoin: round;
    opacity: 0.7;
  }
  .pin {
    stroke: var(--accent);
    stroke-width: 1.4;
  }
  .chip {
    fill: var(--paper);
    stroke: var(--accent);
    stroke-width: 1.6;
  }
  .core {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.6;
  }
  .orbit {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.1;
  }
</style>

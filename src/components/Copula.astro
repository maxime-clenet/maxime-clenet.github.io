---
// Figure: 500 draws from four bivariate copulas with uniform margins.
// Each point keeps its first coordinate u; only v changes between copulas, using the
// conditional quantile v = C^{-1}(w | u) with the same uniform w. The three dependent
// copulas are calibrated to the same Kendall's tau = 0.5, so they differ only in the
// shape of the dependence (symmetric, lower tail, upper tail).
// Points are sampled at build time with a seeded generator, so the figure is static HTML + CSS.

const N = 500;
const TAU = 0.5;

// Seeded uniform generator (mulberry32), kept away from 0 and 1.
let seed = 20261123;
const rand = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  const x = ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  return Math.min(Math.max(x, 1e-6), 1 - 1e-6);
};

// Standard normal CDF and quantile (Acklam's approximation).
const erf = (x: number) => {
  const s = Math.sign(x);
  const a = Math.abs(x);
  const t = 1 / (1 + 0.3275911 * a);
  const y = 1 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-a * a);
  return s * y;
};
const Phi = (x: number) => 0.5 * (1 + erf(x / Math.SQRT2));
const PhiInv = (p: number) => {
  const a = [-39.69683028665376, 220.9460984245205, -275.9285104469687, 138.357751867269, -30.66479806614716, 2.506628277459239];
  const b = [-54.47609879822406, 161.5858368580409, -155.6989798598866, 66.80131188771972, -13.28068155288572];
  const c = [-0.007784894002430293, -0.3223964580411365, -2.400758277161838, -2.549732539343734, 4.374664141464968, 2.938163982698783];
  const d = [0.007784695709041462, 0.3224671290700398, 2.445134137142996, 3.754408661907416];
  const lo = 0.02425;
  if (p < lo) {
    const q = Math.sqrt(-2 * Math.log(p));
    return (((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) / ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1);
  }
  if (p > 1 - lo) return -PhiInv(1 - p);
  const q = p - 0.5;
  const r = q * q;
  return ((((((a[0] * r + a[1]) * r + a[2]) * r + a[3]) * r + a[4]) * r + a[5]) * q) / (((((b[0] * r + b[1]) * r + b[2]) * r + b[3]) * r + b[4]) * r + 1);
};

// Parameters giving Kendall's tau = TAU.
const rho = Math.sin((Math.PI * TAU) / 2); // Gaussian
const thetaC = (2 * TAU) / (1 - TAU); // Clayton
const thetaG = 1 / (1 - TAU); // Gumbel

const gaussian = (u: number, w: number) => Phi(rho * PhiInv(u) + Math.sqrt(1 - rho * rho) * PhiInv(w));
const clayton = (u: number, w: number) =>
  Math.pow((Math.pow(w, -thetaC / (1 + thetaC)) - 1) * Math.pow(u, -thetaC) + 1, -1 / thetaC);
// Gumbel has no closed-form conditional quantile: solve dC/du (u, v) = w by bisection in v.
const gumbel = (u: number, w: number) => {
  const lu = -Math.log(u);
  const h = (v: number) => {
    const s = Math.pow(lu, thetaG) + Math.pow(-Math.log(v), thetaG);
    const A = Math.pow(s, 1 / thetaG);
    return (Math.exp(-A) * Math.pow(s, 1 / thetaG - 1) * Math.pow(lu, thetaG - 1)) / u;
  };
  let a = 1e-9;
  let b = 1 - 1e-9;
  for (let k = 0; k < 60; k++) {
    const m = (a + b) / 2;
    if (h(m) < w) a = m;
    else b = m;
  }
  return (a + b) / 2;
};

const S = 200; // side of the unit square in SVG units
const f = (x: number) => +x.toFixed(1);
const pts = Array.from({ length: N }, () => {
  const u = rand();
  const w = rand();
  return {
    x: f(u * S),
    y: [w, gaussian(u, w), clayton(u, w), gumbel(u, w)].map((v) => f((1 - v) * S)),
    d: Math.round(u * 520 + rand() * 160),
  };
});

const modes = [
  { id: 'indep', label: 'Independent', note: 'No dependence: points fill the square evenly.' },
  { id: 'gauss', label: 'Gaussian', note: 'Symmetric dependence, with no clustering in either corner.' },
  { id: 'clayton', label: 'Clayton', note: 'Lower-tail dependence: small values tend to occur together.' },
  { id: 'gumbel', label: 'Gumbel', note: 'Upper-tail dependence: large values tend to occur together.' },
];
const ticks = [0, 0.5, 1];
---

<figure class="copula" data-mode="gauss">
  <svg viewBox="-22 -10 236 236" role="img" aria-labelledby="cop-title cop-desc">
    <title id="cop-title">Samples from bivariate copulas</title>
    <desc id="cop-desc">
      Five hundred points drawn from a bivariate copula on the unit square. Both coordinates are uniformly distributed
      in every case; switching between the independent, Gaussian, Clayton and Gumbel copulas changes only how the two
      coordinates depend on each other, in particular in the lower and upper corners.
    </desc>
    <rect class="frame" x="0" y="0" width={S} height={S}></rect>
    {ticks.map((t) => <line class="grid" x1={t * S} y1="0" x2={t * S} y2={S}></line>)}
    {ticks.map((t) => <line class="grid" x1="0" y1={t * S} x2={S} y2={t * S}></line>)}
    <rect class="tail tail-lo" x="0" y={S * 0.8} width={S * 0.2} height={S * 0.2}></rect>
    <rect class="tail tail-hi" x={S * 0.8} y="0" width={S * 0.2} height={S * 0.2}></rect>
    <g class="dots">
      {
        pts.map((p) => (
          <circle
            r="1.45"
            style={`--x:${p.x}px;--y0:${p.y[0]}px;--y1:${p.y[1]}px;--y2:${p.y[2]}px;--y3:${p.y[3]}px;--d:${p.d}ms`}
          />
        ))
      }
    </g>
    {ticks.map((t) => <text class="lbl" x={t * S} y={S + 11} text-anchor="middle">{t}</text>)}
    {ticks.slice(1).map((t) => <text class="lbl" x="-5" y={(1 - t) * S + 2.5} text-anchor="end">{t}</text>)}
    <text class="lbl var" x={S + 6} y={S + 2.5}>u</text>
    <text class="lbl var" x="0" y="-4" text-anchor="middle">v</text>
  </svg>
  <figcaption>
    <div class="toggle" role="group" aria-label="Copula">
      {
        modes.map((m) => (
          <button type="button" data-mode={m.id} aria-pressed={String(m.id === 'gauss')}>
            {m.label}
          </button>
        ))
      }
    </div>
    <p class="note" aria-live="polite">
      {modes.map((m) => <span data-note={m.id}>{m.note}</span>)}
    </p>
    <p>
      <span class="eyebrow">Fig. 2</span> Five hundred draws from bivariate copulas. The margins are uniform in every
      panel and the three dependent copulas share the same Kendall's τ = 0.5: they differ only in the shape of the
      dependence, most visibly in the corners.
    </p>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('figure.copula').forEach((fig) => {
    const buttons = fig.querySelectorAll<HTMLButtonElement>('button[data-mode]');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        fig.dataset.mode = b.dataset.mode;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }),
    );
    // Draw the points when the figure scrolls into view.
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          fig.dataset.shown = '';
          io.disconnect();
        }
      },
      { threshold: 0.35 },
    );
    io.observe(fig);
  });
</script>

<style>
  .copula {
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .frame {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 0.6;
  }

  .grid {
    stroke: var(--rule);
    stroke-width: 0.5;
  }

  .tail {
    fill: var(--accent);
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .copula[data-mode='clayton'] .tail-lo,
  .copula[data-mode='gumbel'] .tail-hi {
    opacity: 0.08;
  }

  .dots circle {
    --y: var(--y1);
    fill: var(--accent);
    opacity: 0;
    transform: translate(var(--x), 200px);
    transition:
      transform 1.1s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.6s ease;
    transition-delay: calc(var(--d) * 0.6);
  }

  .copula[data-mode='indep'] .dots circle {
    --y: var(--y0);
  }
  .copula[data-mode='clayton'] .dots circle {
    --y: var(--y2);
  }
  .copula[data-mode='gumbel'] .dots circle {
    --y: var(--y3);
  }

  .copula[data-shown] .dots circle {
    opacity: 0.82;
    transform: translate(var(--x), var(--y));
  }

  @media (prefers-reduced-motion: reduce) {
    .dots circle {
      transition: none;
    }
  }

  /* Without JavaScript the points are shown directly. */
  @media (scripting: none) {
    .dots circle {
      opacity: 0.82;
      transform: translate(var(--x), var(--y));
    }
  }

  .lbl {
    font-family: var(--mono);
    font-size: 7px;
    fill: var(--muted);
  }

  .lbl.var {
    font-style: italic;
    font-size: 8px;
  }

  figcaption {
    margin-top: 1rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted);
  }

  figcaption p {
    margin: 0.9rem 0 0;
    max-width: 30rem;
  }

  figcaption .eyebrow {
    color: var(--accent);
    margin-right: 0.4rem;
  }

  .note {
    color: var(--ink-soft);
    min-height: 1.55em;
  }

  .note span {
    display: none;
  }

  .copula[data-mode='indep'] [data-note='indep'],
  .copula[data-mode='gauss'] [data-note='gauss'],
  .copula[data-mode='clayton'] [data-note='clayton'],
  .copula[data-mode='gumbel'] [data-note='gumbel'] {
    display: inline;
  }

  .toggle {
    display: inline-flex;
    flex-wrap: wrap;
    padding: 3px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    gap: 2px;
  }

  .toggle button {
    font: inherit;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    background: transparent;
    border: 0;
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .toggle button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
</style>

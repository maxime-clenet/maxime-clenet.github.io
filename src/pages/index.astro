---
import { url } from '../utils/url';
import Base from '../layouts/Base.astro';
import Eigen from '../components/Eigen.astro';
import Glyph from '../components/Glyph.astro';
import PubItem from '../components/PubItem.astro';
import { profile, links, statement, path } from '../data/site';
import { themes } from '../data/research';
import { articles } from '../data/publications';

const selected = articles.filter((p) => p.selected);
---

<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow rise">{profile.role} · {profile.affiliation}</p>
      <h1 class="rise d1">{profile.name}</h1>
      <p class="lead rise d2">
        Using mathematics, I study how species diversity, interactions between species, and habitats give rise to the
        properties of communities and ecosystems.
      </p>
      <ul class="pills rise d3">
        <li><a class="pill solid" href={url('/research')}>Research</a></li>
        <li><a class="pill" href={url('/cv')}>CV</a></li>
        {links.map((l) => <li><a class="pill" href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a></li>)}
      </ul>
    </div>
    <div class="hero-fig rise d4">
      <Eigen />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">01 — About</p>
        <h2>Ecology, through mathematics</h2>
      </div>
      <div class="about">
        <div class="prose">
          {statement.map((p) => <p>{p}</p>)}
        </div>
        <ol class="path" aria-label="Career">
          {
            path.map((p) => (
              <li>
                <span class="eyebrow">{p.years}</span>
                <span class="path-place">{p.place}</span>
                <span class="path-what">{p.what}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">02 — Research</p>
        <h2>Five questions I work on</h2>
      </div>
      <ul class="themes">
        {
          themes.map((t, i) => (
            <li>
              <a class="theme" href={url(`/research#${t.id}`)}>
                <Glyph kind={t.glyph} />
                <span class="eyebrow">{String(i + 1).padStart(2, '0')} · {t.field}</span>
                <span class="theme-title">{t.title}</span>
                <span class="theme-q">{t.question}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">03 — Selected work</p>
        <h2>Selected publications</h2>
      </div>
      <ul class="publist">
        {selected.map((p) => <PubItem pub={p} showYear />)}
      </ul>
      <p class="more"><a href={url('/publications')}>All publications →</a></p>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-top: clamp(3rem, 8vw, 7rem);
    padding-bottom: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hero h1 {
    font-size: clamp(3.2rem, 1.6rem + 6.4vw, 6.6rem);
    font-weight: 350;
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin: 1.1rem 0 1.6rem;
  }

  .hero .lead {
    max-width: 34rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-fig {
      max-width: 34rem;
    }
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: 3rem;
  }

  .about .prose {
    grid-column: 2;
    grid-row: 1;
    font-size: 1.075rem;
  }

  .path {
    grid-column: 1;
    grid-row: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    align-content: start;
    border-left: 1px solid var(--rule);
    padding-left: 1.1rem;
  }

  .path li {
    display: grid;
    gap: 0.15rem;
    position: relative;
  }

  .path li::before {
    content: '';
    position: absolute;
    left: calc(-1.1rem - 4px);
    top: 0.35rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--paper);
    border: 1.5px solid var(--accent);
  }

  .path li:first-child::before {
    background: var(--accent);
  }

  .path-place {
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .path-what {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.45;
  }

  @media (max-width: 760px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
    .about .prose,
    .path {
      grid-column: 1;
      grid-row: auto;
    }
  }

  .themes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  /* first theme spans two columns so five cards fill a 3-column grid */
  .themes li:first-child {
    grid-column: span 2;
  }

  .themes li:first-child :global(.glyph) {
    max-width: 16rem;
  }

  @media (max-width: 900px) {
    .themes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .themes {
      grid-template-columns: minmax(0, 1fr);
    }
    .themes li:first-child {
      grid-column: auto;
    }
  }

  .theme {
    display: grid;
    gap: 0.6rem;
    height: 100%;
    padding: 1.4rem 1.4rem 1.6rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
    text-decoration: none;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .theme :global(.glyph) {
    margin-bottom: 0.6rem;
    max-width: 12rem;
  }

  .theme:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 14px 30px -18px color-mix(in srgb, var(--accent) 45%, transparent);
    color: inherit;
  }

  .theme-title {
    font-family: var(--serif);
    font-size: 1.45rem;
    line-height: 1.15;
  }

  .theme-q {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .publist {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .more {
    margin-top: 1.5rem;
    font-size: 0.95rem;
  }

</style>
